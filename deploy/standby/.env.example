# Copy to .env on the VPS and fill in real values:
#   cp .env.example .env && chmod 600 .env
# NEVER commit the filled-in file.

# Domain Caddy serves. Dry run: standby.inferthmapping.co.zw with a DNS record
# pointing at this VPS. Live outage: www.inferthmapping.co.zw (default).
SITE_DOMAIN=www.inferthmapping.co.zw

# Railway Postgres through its public TCP proxy.
# Railway dashboard -> Postgres service -> Connect -> Public Network gives a
# host like xxxx.proxy.rlwy.net and a port. Use them here:
DATABASE_URL=postgresql+asyncpg://postgres:DB_PASSWORD@HOST.proxy.rlwy.net:PORT/inferth

# MUST be identical to the Railway service's JWT_SECRET — otherwise every
# logged-in session becomes invalid the moment traffic fails over.
JWT_SECRET=

# Same values as the Railway service. TRACKER_JWT_SECRETS is a JSON map
# {"IMEI":"secret",...} — needed once trackers are pointed at this host.
TRACKER_AUTH_MODE=monitor
TRACKER_JWT_SECRETS={}

# Payments and notifications — copy the Railway service variables so alerts
# and checkout keep working on the standby.
PAYNOW_ID=
PAYNOW_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_BASE_URL=
SMS_SENDER=Inferth
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
