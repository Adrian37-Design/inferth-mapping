# Inferth Mapping — backend environment template
# Copy to backend/.env (gitignored) or set these in Railway Variables.
# NEVER commit real values. Any value previously committed must be rotated.

# --- Required ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
JWT_SECRET=change-me-generate-a-64-char-random-string   # python -c "import secrets;print(secrets.token_hex(32))"

# --- Payments (Paynow Zimbabwe — EcoCash/OneMoney/Zimswitch) ---
PAYNOW_INTEGRATION_ID=0000
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key

# --- Deployment / CORS ---
# Comma-separated list of allowed browser origins. Include the Railway URL
# and the custom domain(s). No '*' — credentials are in use.
CORS_ORIGINS=https://inferth-mapping.up.railway.app,https://www.inferthmapping.co.zw,https://inferthmapping.co.zw
ENVIRONMENT=production        # 'production' disables /docs & OpenAPI
BASE_URL=https://www.inferthmapping.co.zw

# --- Map matching (route history) ---
# Valhalla trace_attributes endpoint (self-hosted recommended).
MAP_MATCH_URL=https://valhalla1.openstreetmap.de/trace_attributes
# Optional bearer/API key if the matcher requires it
MAP_MATCH_API_KEY=

# --- Tracker command authentication ---
# 'log' = verify signatures when present but allow unsigned (transition mode)
# 'enforce' = reject any command request without a valid per-IMEI signature
TRACKER_AUTH_MODE=log
TRACKER_SECRET_TTL=86400

# --- Redis (live updates) ---
REDIS_URL=redis://localhost:6379

# --- WhatsApp invites (self-hosted open-source gateway) ---
# Deploy Evolution API (github.com/EvolutionAPI/evolution-api) or WAHA
# (github.com/devlikeapro/whatsapp-http-api) as a separate service, link a
# dedicated WhatsApp number by QR code, then point this at its REST API.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=evolution          # or: waha
WHATSAPP_API_URL=https://your-gateway.up.railway.app
WHATSAPP_API_KEY=your-gateway-api-key
WHATSAPP_SESSION=inferth             # Evolution instance name / WAHA session name

# --- SMTP (invite/reset emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-account@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAILS_FROM=noreply@inferthmapping.co.zw

# --- Admin bootstrap (one-off scripts only) ---
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-strong-unique-password
